rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isExchangeParticipant(data) {
      return signedIn()
        && (data.senderId == request.auth.uid
          || data.receiverId == request.auth.uid);
    }

    function isSessionParticipant(data) {
      return signedIn()
        && (data.teacherId == request.auth.uid
          || data.learnerId == request.auth.uid);
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function sessionExchange(data) {
      return get(
        /databases/$(database)/documents/exchangeRequests/$(data.exchangeRequestId)
      ).data;
    }

    function belongsToAcceptedExchange(data) {
      let exchange = sessionExchange(data);
      return exchange.status == 'ACCEPTED'
        && (
          (exchange.senderId == data.teacherId
            && exchange.receiverId == data.learnerId
            && exchange.offeredSkillId == data.skillId)
          || (exchange.senderId == data.learnerId
            && exchange.receiverId == data.teacherId
            && exchange.requestedSkillId == data.skillId)
        );
    }

    function protectedUserFields() {
      return [
        'admin', 'isAdmin', 'role', 'isActive', 'skillCredits',
        'suspended', 'suspendedAt', 'suspendedBy', 'isSuspended'
      ];
    }

    function validExchangeRequest(data) {
      return data.keys().hasOnly([
          'senderId', 'receiverId', 'exchangeType', 'offeredSkillId',
          'requestedSkillId', 'creditAmount', 'message', 'status',
          'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(data.senderId)
        && isNonEmptyString(data.receiverId)
        && data.senderId != data.receiverId
        && isNonEmptyString(data.offeredSkillId)
        && isNonEmptyString(data.requestedSkillId)
        && data.offeredSkillId != data.requestedSkillId
        && data.exchangeType in ['DIRECT', 'CREDIT']
        && data.creditAmount is int
        && (
          (data.exchangeType == 'DIRECT' && data.creditAmount == 0)
          || (data.exchangeType == 'CREDIT' && data.creditAmount == 10)
        )
        && data.message is string;
    }

    function validSession(data) {
      return data.keys().hasOnly([
          'exchangeRequestId', 'teacherId', 'learnerId', 'skillId',
          'proposedBy', 'scheduledAt', 'duration', 'sessionType', 'location',
          'meetingLink', 'status', 'completedBy', 'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(data.exchangeRequestId)
        && isNonEmptyString(data.teacherId)
        && isNonEmptyString(data.learnerId)
        && isNonEmptyString(data.proposedBy)
        && data.proposedBy == request.auth.uid
        && data.teacherId != data.learnerId
        && isNonEmptyString(data.skillId)
        && data.scheduledAt is timestamp
        && data.duration is int
        && data.duration >= 15
        && data.duration <= 240
        && data.sessionType in ['ONLINE', 'IN_PERSON']
        && (!data.keys().hasAny(['location']) || data.location is string)
        && (!data.keys().hasAny(['meetingLink']) || data.meetingLink is string)
        && (
          (data.sessionType == 'ONLINE'
            && data.keys().hasAny(['meetingLink'])
            && isNonEmptyString(data.meetingLink))
          || (data.sessionType == 'IN_PERSON'
            && data.keys().hasAny(['location'])
            && isNonEmptyString(data.location))
        )
        && data.status == 'PROPOSED'
        && data.completedBy is list
        && data.completedBy.size() == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidSessionProposer(data) {
      return data.keys().hasAny(['proposedBy'])
        && isNonEmptyString(data.proposedBy)
        && data.proposedBy in [data.teacherId, data.learnerId];
    }

    function validCatalogRecord(data, isCategory) {
      return isNonEmptyString(data.name)
        && data.name.size() <= 100
        && (!data.keys().hasAny(['description'])
          || data.description == null
          || (data.description is string && data.description.size() <= 1000))
        && (!data.keys().hasAny(['categoryId'])
          || data.categoryId == null
          || data.categoryId is string)
        && (isCategory || data.keys().hasAny(['categoryId']));
    }

    function validSkillSuggestion(data) {
      return data.keys().hasOnly([
          'name', 'categoryId', 'description', 'submittedBy', 'status',
          'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(data.name)
        && data.name.size() <= 100
        && (!data.keys().hasAny(['categoryId'])
          || data.categoryId == null
          || data.categoryId is string)
        && (!data.keys().hasAny(['description'])
          || data.description == null
          || (data.description is string && data.description.size() <= 500))
        && isNonEmptyString(data.submittedBy)
        && data.status == 'PENDING'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if ownsUser(userId)
        && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if (
          isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['skillCredits'])
        )
        || (ownsUser(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(protectedUserFields())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'admin', 'isAdmin', 'role', 'isActive', 'suspended', 'suspendedAt'
          ])
          // Server-managed fields: written only by Cloud Functions (Admin SDK).
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'xp', 'level', 'ratingAverage', 'ratingCount', 'streak', 'skillCredits'
          ]));
      allow delete: if isAdmin();
    }

    match /userSkills/{skillId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && isNonEmptyString(request.resource.data.userId));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && isNonEmptyString(request.resource.data.userId));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /skills/{skillId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && validCatalogRecord(request.resource.data, false)
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'categoryId', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validCatalogRecord(request.resource.data, false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'categoryId', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && validCatalogRecord(request.resource.data, true)
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'createdAt', 'updatedAt', 'createdBy',
          'updatedBy'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validCatalogRecord(request.resource.data, true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /skillSuggestions/{suggestionId} {
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && validSkillSuggestion(request.resource.data);
      allow read: if isAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /exchangeRequests/{requestId} {
      allow read: if isAdmin() || isExchangeParticipant(resource.data);
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.status == 'PENDING'
          && validExchangeRequest(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time);
      allow update: if isAdmin()
        || (isExchangeParticipant(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (resource.data.status == 'PENDING'
              && request.resource.data.status == 'CANCELLED')
            || (resource.data.status == 'PENDING'
              && request.resource.data.status in ['ACCEPTED', 'REJECTED']
              && resource.data.receiverId == request.auth.uid)
            || (resource.data.status == 'ACCEPTED'
              && request.resource.data.status == 'CANCELLED')
          ));
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() || isSessionParticipant(resource.data);
      allow create: if isAdmin()
        || (isSessionParticipant(request.resource.data)
          && validSession(request.resource.data)
          && belongsToAcceptedExchange(request.resource.data));
      allow update: if isAdmin()
        || (isSessionParticipant(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'updatedAt', 'completedBy', 'creditsTransferred',
              'scheduledAt', 'proposedBy', 'proposalResolution'
            ])
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
              && (
                (resource.data.status == 'PROPOSED'
                  && request.resource.data.status == 'CONFIRMED'
                  && hasValidSessionProposer(resource.data)
                  && resource.data.proposedBy != request.auth.uid)
                || (resource.data.status == 'CONFIRMED'
                  && request.resource.data.status
                    in ['IN_PROGRESS', 'CANCELLED', 'DISPUTED'])
                || (resource.data.status == 'IN_PROGRESS'
                  && request.resource.data.status in ['CANCELLED', 'DISPUTED'])
              ))
            || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt', 'proposalResolution'])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasAll(['status', 'updatedAt', 'proposalResolution'])
              && !resource.data.keys().hasAny(['proposalResolution'])
              && resource.data.status == 'PROPOSED'
              && request.resource.data.status == 'CANCELLED'
              && hasValidSessionProposer(resource.data)
              && resource.data.proposedBy != request.auth.uid
              && request.resource.data.proposalResolution == 'REJECTED')
            || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt', 'proposalResolution'])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasAll(['status', 'updatedAt', 'proposalResolution'])
              && !resource.data.keys().hasAny(['proposalResolution'])
              && resource.data.status == 'PROPOSED'
              && request.resource.data.status == 'CANCELLED'
              && hasValidSessionProposer(resource.data)
              && resource.data.proposedBy == request.auth.uid
              && request.resource.data.proposalResolution == 'WITHDRAWN')
            || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['scheduledAt', 'proposedBy', 'updatedAt'])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasAll(['scheduledAt', 'proposedBy', 'updatedAt'])
              && resource.data.status == 'PROPOSED'
              && request.resource.data.status == 'PROPOSED'
              && hasValidSessionProposer(resource.data)
              && resource.data.proposedBy != request.auth.uid
              && request.resource.data.proposedBy == request.auth.uid
              && request.resource.data.scheduledAt is timestamp
              && request.resource.data.scheduledAt > request.time)
            || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['completedBy', 'updatedAt'])
              && resource.data.status in ['CONFIRMED', 'IN_PROGRESS']
              && resource.data.completedBy is list
              && request.resource.data.completedBy is list
              && request.resource.data.completedBy.size()
                == resource.data.completedBy.size() + 1
              && request.resource.data.completedBy.hasAll(resource.data.completedBy)
              && request.resource.data.completedBy.hasAny([request.auth.uid])
              && !resource.data.completedBy.hasAny([request.auth.uid]))
            || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'updatedAt', 'completedBy', 'creditsTransferred'
                ])
              && resource.data.status in ['CONFIRMED', 'IN_PROGRESS']
              && request.resource.data.status == 'COMPLETED'
              && resource.data.completedBy.hasAny([
                resource.data.teacherId, resource.data.learnerId
              ])
              && !resource.data.completedBy.hasAny([request.auth.uid])
              && request.resource.data.completedBy.hasAll([
                resource.data.teacherId, resource.data.learnerId
              ])
              && request.resource.data.completedBy.size() == 2
              && belongsToAcceptedExchange(resource.data)
              && sessionExchange(resource.data).exchangeType == 'DIRECT'
              && request.resource.data.creditsTransferred == false)
          ));
      allow delete: if isAdmin();
    }

    match /creditTransactions/{transactionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create, update, delete: if false;

      match /moderationHistory/{eventId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // =====================================================================
    // Member 5: Chat, Notifications, Gamification
    // Cloud Functions (Admin SDK) bypass these rules. XP, levels, ratings,
    // badges, attempts and notifications are written only by functions
    // (exception: Spark-plan event notifications, see validClientNotification).
    // =====================================================================

    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isConversationParticipant(conversation) {
      return signedIn() && request.auth.uid in conversation.participantIds;
    }

    function validChatImageBase64(value) {
      return value is string
        && value.size() <= 700000
        && value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$');
    }

    function validLegacyChatImageUrl(value) {
      return value is string
        && value.matches('^https://firebasestorage.googleapis.com/.*$');
    }

    function acceptedExchangeBetween(requestId, participantIds) {
      let exchange = get(
        /databases/$(database)/documents/exchangeRequests/$(requestId)
      ).data;
      return exchange.status in ['ACCEPTED', 'COMPLETED']
        && participantIds.hasAll([exchange.senderId, exchange.receiverId]);
    }

    function reviewableSession(sessionId, revieweeId) {
      let session = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return session.status == 'COMPLETED'
        && ((session.teacherId == request.auth.uid && session.learnerId == revieweeId)
          || (session.learnerId == request.auth.uid && session.teacherId == revieweeId));
    }

    // Sender's preview update: only lastMessage / lastMessageAt / unreadCounts change,
    // lastMessageAt is the server time, and only the other participant's count goes
    // up by exactly one.
    function validMessagePreviewUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let other = before.participantIds[0] == request.auth.uid
        ? before.participantIds[1]
        : before.participantIds[0];
      let oldCounts = before.get('unreadCounts', {});
      return before.participantIds.size() == 2
        && after.diff(before).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'unreadCounts'])
        && after.lastMessage is string
        && after.lastMessage.size() > 0
        && after.lastMessage.size() <= 200
        && after.lastMessageAt == request.time
        && after.unreadCounts is map
        && after.unreadCounts.diff(oldCounts).affectedKeys().hasOnly([other])
        && after.unreadCounts[other] == oldCounts.get(other, 0) + 1;
    }

    // Conversation id == exchangeRequestId (one chat per accepted exchange).
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'exchangeRequestId', 'lastMessage',
          'lastMessageAt', 'createdAt', 'unreadCounts'
        ])
        && request.resource.data.exchangeRequestId == conversationId
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.lastMessage == ''
        && request.resource.data.unreadCounts.keys()
          .hasOnly(request.resource.data.participantIds)
        && request.resource.data.unreadCounts[request.resource.data.participantIds[0]] == 0
        && request.resource.data.unreadCounts[request.resource.data.participantIds[1]] == 0
        && acceptedExchangeBetween(conversationId, request.resource.data.participantIds);
      // A participant may reset their own unread count to 0, or (Spark plan, after
      // sending a message) set the preview and bump the other participant's count by 1.
      allow update: if isConversationParticipant(resource.data)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCounts'])
            && request.resource.data.unreadCounts[request.auth.uid] == 0
            && (
              (!('unreadCounts' in resource.data)
                && request.resource.data.unreadCounts.keys().hasOnly([request.auth.uid]))
              || ('unreadCounts' in resource.data
                && request.resource.data.unreadCounts.diff(resource.data.unreadCounts)
                  .affectedKeys().hasOnly([request.auth.uid]))
            ))
          || validMessagePreviewUpdate()
        );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationData(conversationId));
        allow create: if isConversationParticipant(conversationData(conversationId))
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'imageUrl', 'imageBase64', 'createdAt', 'isRead'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            request.resource.data.text.size() > 0
            || (
              ('imageBase64' in request.resource.data
                && validChatImageBase64(request.resource.data.imageBase64))
              || ('imageUrl' in request.resource.data
                && validLegacyChatImageUrl(request.resource.data.imageUrl))
            )
          )
          && (
            !('imageBase64' in request.resource.data)
            || validChatImageBase64(request.resource.data.imageBase64)
          )
          && (
            !('imageUrl' in request.resource.data)
            || validLegacyChatImageUrl(request.resource.data.imageUrl)
          )
          && request.resource.data.createdAt == request.time
          && request.resource.data.isRead == false;
        // The recipient may mark a message as read; nothing else changes.
        allow update: if isConversationParticipant(conversationData(conversationId))
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if isAdmin();
      }
    }

    // Spark-plan fallback: the app creates event notifications itself. The id is
    // `${type}_${key}_${userId}`, the same id the Cloud Functions use (create-once),
    // so client and function never write duplicates. Each type checks that the
    // referenced doc exists and that the writer and recipient hold the right roles.
    function validClientNotification(notificationId, key) {
      let n = request.resource.data;
      return n.keys().hasOnly([
          'userId', 'type', 'title', 'body', 'referenceId', 'isRead', 'createdAt'
        ])
        && n.keys().hasAll([
          'userId', 'type', 'title', 'body', 'referenceId', 'isRead', 'createdAt'
        ])
        && isNonEmptyString(n.userId)
        && n.userId != request.auth.uid
        && isNonEmptyString(n.referenceId)
        && notificationId == n.type + '_' + key + '_' + n.userId
        && n.isRead == false
        && n.createdAt == request.time
        && isNonEmptyString(n.title) && n.title.size() <= 100
        && isNonEmptyString(n.body) && n.body.size() <= 300;
    }

    function validExchangeNotification(notificationId) {
      let n = request.resource.data;
      let exchange = get(
        /databases/$(database)/documents/exchangeRequests/$(n.referenceId)
      ).data;
      return validClientNotification(notificationId, n.referenceId)
        && (
          // Sender tells the receiver about a new request.
          (n.type == 'EXCHANGE_REQUEST'
            && exchange.senderId == request.auth.uid
            && exchange.receiverId == n.userId
            && exchange.status == 'PENDING')
          // Receiver tells the sender about the decision.
          || (n.type == 'REQUEST_ACCEPTED'
            && exchange.receiverId == request.auth.uid
            && exchange.senderId == n.userId
            && exchange.status in ['ACCEPTED', 'COMPLETED'])
          || (n.type == 'REQUEST_REJECTED'
            && exchange.receiverId == request.auth.uid
            && exchange.senderId == n.userId
            && exchange.status == 'REJECTED')
        );
    }

    // NEW_MESSAGE_${conversationId}_${messageId}_${userId}; referenceId is the
    // conversation. The message id is cut out of the notification id, and that
    // message must exist and be sent by the writer.
    function validMessageNotification(notificationId) {
      let n = request.resource.data;
      let prefix = 'NEW_MESSAGE_' + n.referenceId + '_';
      let messageId = notificationId[prefix.size():notificationId.size() - n.userId.size() - 1];
      let conversation = conversationData(n.referenceId);
      let message = get(
        /databases/$(database)/documents/conversations/$(n.referenceId)/messages/$(messageId)
      ).data;
      return messageId.size() > 0
        && validClientNotification(notificationId, n.referenceId + '_' + messageId)
        && request.auth.uid in conversation.participantIds
        && n.userId in conversation.participantIds
        && message.senderId == request.auth.uid;
    }

    // NEW_REVIEW_${reviewId}_${userId}: the writer is the reviewer, the recipient the reviewee.
    function validReviewNotification(notificationId) {
      let n = request.resource.data;
      let review = get(/databases/$(database)/documents/reviews/$(n.referenceId)).data;
      return validClientNotification(notificationId, n.referenceId)
        && review.reviewerId == request.auth.uid
        && review.revieweeId == n.userId;
    }

    // SESSION_*_${sessionId}_${userId}: writer and recipient are the session's two
    // participants, and the session is in the state the type announces.
    function validSessionNotification(notificationId) {
      let n = request.resource.data;
      let session = get(/databases/$(database)/documents/sessions/$(n.referenceId)).data;
      return validClientNotification(notificationId, n.referenceId)
        && (
          (session.teacherId == request.auth.uid && session.learnerId == n.userId)
          || (session.learnerId == request.auth.uid && session.teacherId == n.userId)
        )
        && (
          (n.type == 'SESSION_SCHEDULED'
            && session.status in ['PROPOSED', 'CONFIRMED'])
          || (n.type == 'SESSION_CONFIRMED'
            && session.status in ['CONFIRMED', 'IN_PROGRESS', 'COMPLETED'])
          || (n.type == 'SESSION_CANCELLED' && session.status == 'CANCELLED')
          || (n.type == 'SESSION_COMPLETED' && session.status == 'COMPLETED')
        );
    }

    match /notifications/{notificationId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;
      // Only these types may come from the app; all others (NEW_MATCH, BADGE_EARNED,
      // LEVEL_UP, SESSION_REMINDER) are created only by Cloud Functions.
      allow create: if signedIn()
        && (
          (request.resource.data.type in ['EXCHANGE_REQUEST', 'REQUEST_ACCEPTED', 'REQUEST_REJECTED']
            && validExchangeNotification(notificationId))
          || (request.resource.data.type == 'NEW_MESSAGE'
            && validMessageNotification(notificationId))
          || (request.resource.data.type == 'NEW_REVIEW'
            && validReviewNotification(notificationId))
          || (request.resource.data.type in [
              'SESSION_SCHEDULED', 'SESSION_CONFIRMED', 'SESSION_CANCELLED', 'SESSION_COMPLETED'
            ]
            && validSessionNotification(notificationId))
        );
    }

    // Review id == `${sessionId}_${reviewerId}`: one review per reviewer per session.
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && reviewId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'sessionId', 'reviewerId', 'revieweeId', 'rating', 'comment', 'tags', 'createdAt'
        ])
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 6
        && request.resource.data.createdAt == request.time
        && reviewableSession(request.resource.data.sessionId, request.resource.data.revieweeId);
      allow update, delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Answer keys: Cloud Functions only. Never readable by clients.
    match /challengeAnswers/{challengeId} {
      allow read, write: if false;
    }

    match /challengeAttempts/{attemptId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /badges/{badgeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /userBadges/{userBadgeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /xpTransactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /pushTokens/{userId} {
      allow read, delete: if ownsUser(userId);
      allow create, update: if ownsUser(userId)
        && request.resource.data.keys().hasOnly(['userId', 'token', 'platform', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.token is string
        && request.resource.data.platform in ['ios', 'android', 'web'];
    }
  }
}
